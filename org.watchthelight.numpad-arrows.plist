<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- <wtl> numpad arrows login item: event tap that turns Num1/5/2/3 into arrow keys | author: watchthelight </wtl> -->
<!-- install.sh replaces __BIN__ with the installed binary's full path (default ~/.local/bin/numpad-arrows-tap) -->
<plist version="1.0">
<dict>
  <key>Label</key><string>org.watchthelight.numpad-arrows</string>
  <key>ProgramArguments</key>
  <array><string>__BIN__</string></array>
  <key>RunAtLoad</key><true/>
  <key>KeepAlive</key><true/>
  <key>ThrottleInterval</key><integer>10</integer>
</dict>
</plist>
